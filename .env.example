# Environment for m365 CLI. Copy to .env and fill in using THE COMMANDS BELOW, not memory.
# Loaded by:  source scripts/env.sh      (state check:  npm run doctor)

# Signed-in account and tenant     ->  m365 status  |  m365 tenant id get
M365_ACCOUNT=
M365_TENANT_ID=

# SharePoint root of the tenant. NOTE: the hostname need not match the account's domain.
# Verify (must return Title/Url, not {"error":{}}):
#   m365 spo web get --url "$M365_SPO_ROOT" --output json --query '{t:Title,u:Url}'
M365_SPO_ROOT=
M365_SPO_ADMIN=

# The site this project works against (a web under M365_SPO_ROOT)
M365_SITE=
