# Prostředí pro m365 CLI. Zkopíruj na .env a naplň PŘÍKAZY NÍŽE, ne z paměti.
# Načítá se přes:  source scripts/env.sh     (kontrolu stavu udělá: npm run doctor)

# Přihlášený účet a tenant       ->  m365 status  |  m365 tenant id get
M365_ACCOUNT=
M365_TENANT_ID=

# Kořen SharePointu tenantu. POZOR: doména se nemusí shodovat s doménou účtu.
# Ověření (musí vrátit Title/Url, ne {"error":{}}):
#   m365 spo web get --url "$M365_SPO_ROOT" --output json --query '{t:Title,u:Url}'
M365_SPO_ROOT=
M365_SPO_ADMIN=

# Cílový web, se kterým projekt pracuje (podweb pod M365_SPO_ROOT)
M365_SITE=
